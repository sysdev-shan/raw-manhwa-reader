{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAW",
  "version": "0.1.0",
  "identifier": "app.raw.reader",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "RAW",
        "width": 420,
        "height": 800,
        "minWidth": 340,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; worker-src blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "RAW",
    "shortDescription": "Lightweight manhwa reader",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
